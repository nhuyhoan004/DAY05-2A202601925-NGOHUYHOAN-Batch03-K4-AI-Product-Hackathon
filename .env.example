# === Cấu hình Bot Discord ===
# Token của Bot lấy từ Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token

# ID của Server Discord (Guild ID). Để lấy ID, bật Developer Mode rồi Copy Server ID.
DISCORD_GUILD_ID=123456789012345678

# ID role MOD được bot mention khi không có đủ căn cứ để trả lời.
MOD_ROLE_ID=1532584932386537583

# === Cấu hình AI / LLM (OpenAI) ===
# API Key của OpenAI (bắt đầu bằng sk-...)
OPENAI_API_KEY=your_openai_api_key

# URL trỏ tới API của OpenAI (hoặc để trống)
OPENAI_BASE_URL=https://api.openai.com/v1

# Tên model dùng để sinh câu trả lời
OPENAI_MODEL=gpt-4o-mini

# Cấu hình Embedding qua OpenAI API
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32

# === Cấu hình RAG ===
# Số lượng tin nhắn tối đa được lấy lên từ cơ sở dữ liệu FAISS để làm ngữ cảnh
TOP_K=5
