# === Cấu hình Bot Discord ===
# Token của Bot lấy từ Discord Developer Portal (https://discord.com/developers/applications)
# Không commit token thật vào Git.
DISCORD_TOKEN=your_discord_bot_token

# ID của Server Discord (Guild ID). Để lấy ID, bật Developer Mode rồi Copy Server ID.
DISCORD_GUILD_ID=123456789012345678

# === Cấu hình AI / LLM ===
# API Key của OpenRouter (thường bắt đầu bằng sk-or-...)
OPENAI_API_KEY=your_openrouter_or_openai_api_key

# URL trỏ tới API của OpenRouter. Để trống nếu dùng OpenAI trực tiếp.
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Tên model dùng để sinh câu trả lời trên OpenRouter
OPENAI_MODEL=openai/gpt-4o-mini

# Embedding qua OpenRouter API; không tải model local vào RAM.
OPENROUTER_API_KEY=your_openrouter_api_key
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32

# === Cấu hình RAG ===
# Số lượng tin nhắn tối đa được lấy lên từ cơ sở dữ liệu FAISS để làm ngữ cảnh
TOP_K=5
