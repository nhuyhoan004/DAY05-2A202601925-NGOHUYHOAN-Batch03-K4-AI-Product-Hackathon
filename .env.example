# === Cấu hình Bot Discord ===
# Token của Bot lấy từ Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=MTUzMjQ...

# ID của Server Discord (Guild ID). Để lấy ID, hãy bật Developer Mode trong Cài đặt Discord, sau đó click chuột phải vào Server -> Copy Server ID
DISCORD_GUILD_ID=123456789012345678

# === Cấu hình AI / LLM ===
# API Key của OpenRouter (thường bắt đầu bằng sk-or-...)
OPENAI_API_KEY=sk-or-v1-..

# URL trỏ tới API của OpenRouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Tên model dùng để sinh câu trả lời trên OpenRouter
OPENAI_MODEL=openai/gpt-4o-mini

# Tên model dùng để tạo vector embedding (Ví dụ: text-embedding-3-small, text-embedding-ada-002)
EMBEDDING_MODEL=text-embedding-3-small

# === Cấu hình RAG ===
# Số lượng tin nhắn tối đa được lấy lên từ cơ sở dữ liệu FAISS để làm ngữ cảnh
TOP_K=5
